{
  "name": "relanmo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "check": "bun run lint",
    "clean": "git clean -xdf node_modules .turbo",
    "dev": "turbo run dev",
    "fix": "bun run format",
    "format": "ultracite fix",
    "lint": "ultracite check",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "typecheck:fresh": "node tooling/commands/typecheck-fresh.mjs",
    "verify:install": "bun install --frozen-lockfile",
    "verify:node": "node tooling/commands/node-smoke.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@relanmo/typescript-config": "workspace:*",
    "turbo": "2.10.13",
    "typescript": "7.0.2",
    "ultracite": "7.12.0",
    "vitest": "5.0.1"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=24.21.0 <25"
  }
}
