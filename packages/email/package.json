{
  "name": "@relanmo/email",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./delivery": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/delivery/index.ts",
      "default": "./src/delivery/index.ts"
    },
    "./delivery/*": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/delivery/*.ts",
      "default": "./src/delivery/*.ts"
    },
    "./templates": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/templates/index.ts",
      "default": "./src/templates/index.ts"
    },
    "./templates/*": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/templates/*.tsx",
      "default": "./src/templates/*.tsx"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@react-email/components": "1.0.12",
    "@react-email/render": "2.1.0",
    "@relanmo/domain": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "resend": "6.28.1",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@relanmo/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2"
  }
}
