{
  "name": "@relanmo/prompts",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./defaults": {
      "types": "./src/defaults/index.ts",
      "default": "./src/defaults/index.ts"
    },
    "./defaults/*": {
      "types": "./src/defaults/*.ts",
      "default": "./src/defaults/*.ts"
    },
    "./fixtures": {
      "types": "./src/fixtures/index.ts",
      "default": "./src/fixtures/index.ts"
    },
    "./fixtures/*": {
      "types": "./src/fixtures/*.ts",
      "default": "./src/fixtures/*.ts"
    },
    "./composition": {
      "types": "./src/composition/index.ts",
      "default": "./src/composition/index.ts"
    },
    "./composition/*": {
      "types": "./src/composition/*.ts",
      "default": "./src/composition/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@relanmo/domain": "workspace:*",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@relanmo/typescript-config": "workspace:*",
    "typescript": "7.0.2"
  }
}
