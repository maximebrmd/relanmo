{
  "name": "@relanmo/auth",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./server": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/server/index.ts",
      "default": "./src/server/index.ts"
    },
    "./server/*": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/server/*.ts",
      "default": "./src/server/*.ts"
    },
    "./client": {
      "types": "./src/client/index.ts",
      "default": "./src/client/index.ts"
    },
    "./client/*": {
      "types": "./src/client/*.ts",
      "default": "./src/client/*.ts"
    },
    "./session": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/session/index.ts",
      "default": "./src/session/index.ts"
    },
    "./session/*": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/session/*.ts",
      "default": "./src/session/*.ts"
    },
    "./schema-config": {
      "browser": "./src/next-client-reject.ts",
      "types": "./src/schema-config.ts",
      "default": "./src/schema-config.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.5",
    "@relanmo/database": "workspace:*",
    "@relanmo/email": "workspace:*",
    "better-auth": "1.7.5",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@relanmo/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "7.0.2",
    "vitest": "5.0.1"
  }
}
