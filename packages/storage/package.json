{
  "name": "@relanmo/storage",
  "version": "0.0.0",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./r2": {
      "types": "./src/r2/index.ts",
      "default": "./src/r2/index.ts"
    },
    "./r2/*": {
      "types": "./src/r2/*.ts",
      "default": "./src/r2/*.ts"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1135.0",
    "@aws-sdk/s3-request-presigner": "3.1135.0",
    "@relanmo/domain": "workspace:*",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@relanmo/typescript-config": "workspace:*",
    "@types/node": "24.13.5",
    "typescript": "7.0.2"
  }
}
