{
  "extends": "@relanmo/typescript-config/nextjs.json",
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@relanmo/*": ["../../packages/*"],
      "@relanmo/auth/*": ["../../packages/auth/src/*"],
      "@relanmo/connectors/*": ["../../packages/connectors/src/*"],
      "@relanmo/database/*": ["../../packages/database/src/*"],
      "@relanmo/domain/*": ["../../packages/domain/src/*"],
      "@relanmo/email/*": ["../../packages/email/src/*"],
      "@relanmo/observability/*": ["../../packages/observability/src/*"],
      "@relanmo/payments/*": ["../../packages/payments/src/*"],
      "@relanmo/prompts/*": ["../../packages/prompts/src/*"],
      "@relanmo/storage/*": ["../../packages/storage/src/*"],
      "@relanmo/workflows/*": ["../../packages/workflows/src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": ["node_modules"]
}
